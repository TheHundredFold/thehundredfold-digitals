---
import { site } from "../data/site";
---
    <section class="contact-section" id="contact" aria-labelledby="contact-title"><p class="eyebrow">04 / WHAT COULD WE CONNECT?</p><h2 id="contact-title">Good work starts<br>with a <em>conversation.</em></h2><div class="contact-bottom"><p>Tell me what takes too much time.<br>Let’s explore what a better system could look like.</p><a class="contact-link" href={site.emailHref}>Let’s build something <span aria-hidden="true">↗</span></a></div><div class="contact-channels"><a class="contact-email" href={site.emailHref}>{site.email}</a><a class="whatsapp-link" href={site.whatsappHref} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span><small>{site.phone}</small></a></div></section>
